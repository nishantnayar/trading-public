# Copy to .env and fill in. .env is git-ignored.

# --- Postgres (local, Postgres 18 service: postgresql-x64-18) ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=quantis
PGUSER=postgres
PGPASSWORD=

# SQLAlchemy URL is derived from the above in src/quantis/config.py

# --- Alpaca (paper account: https://alpaca.markets) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# --- Prefect (ISOLATED home + SQLite backend, distinct port from other projects) ---
# PREFECT_HOME must be project-local so quantis gets its OWN prefect.db and never reads
# another project's shared ~/.prefect DB (which is on a different Prefect version).
# trading-system uses 4200 on this machine; quantis uses 4201.
# Use scripts/prefect_server.ps1 to start the server with these set.
PREFECT_HOME=D:\PythonProjects\trading-public\.prefect
PREFECT_API_URL=http://127.0.0.1:4201/api
PREFECT_SERVER_API_PORT=4201
PREFECT_WORK_POOL=quantis-ingestion

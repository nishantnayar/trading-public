# Copy to .env and fill in. .env is git-ignored.

# --- Postgres (local, Postgres 18 service: postgresql-x64-18) ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=quantis
PGUSER=postgres
PGPASSWORD=

# SQLAlchemy URL is derived from the above in src/quantis/config.py

# --- Alpaca (paper account: https://alpaca.markets) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# --- Prefect (own profile; SQLite backend, distinct port from other projects) ---
# trading-system uses 4200 on this machine; quantis uses 4201.
# Orchestration metadata lives in a local SQLite profile (see scripts/prefect_profile.*),
# NOT Postgres. For a production upgrade, set PREFECT_API_DATABASE_CONNECTION_URL to a
# dedicated Postgres DB instead.
PREFECT_API_URL=http://localhost:4201/api
PREFECT_WORK_POOL=quantis-ingestion

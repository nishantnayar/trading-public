# Copy to .env and fill in. .env is git-ignored.

# --- Postgres (local, Postgres 18 service: postgresql-x64-18) ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=quantis
PGUSER=postgres
PGPASSWORD=

# SQLAlchemy URL is derived from the above in src/quantis/config.py

# --- Alpaca (paper account: https://alpaca.markets) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# --- Source OHLC copy (one-time bootstrap ETL from another project's DB) ---
# Leave blank until the source project/table is identified.
SOURCE_PG_URL=
SOURCE_OHLC_TABLE=
